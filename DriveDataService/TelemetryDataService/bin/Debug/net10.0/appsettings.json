{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "InfluxDB": {
    "Url": "http://localhost:8086",
    "Token": "my-secret-token",
    "Org": "MyOrg",
    "Bucket": "Events"
  }
}
